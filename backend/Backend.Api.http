@host = http://localhost:55146
@json = application/json

### Listar departamentos
GET {{host}}/api/departamentos
Accept: {{json}}

### Crear departamento (201)
POST {{host}}/api/departamentos
Content-Type: {{json}}
Accept: {{json}}

{
  "nombre": "Producto"
}

### Obtener departamento inexistente (error esperado 404)
GET {{host}}/api/departamentos/999999
Accept: {{json}}

### Crear departamento inválido (400)
POST {{host}}/api/departamentos
Content-Type: {{json}}
Accept: {{json}}

{
  "nombre": "   "
}

### Actualizar departamento (200)
PUT {{host}}/api/departamentos/1
Content-Type: {{json}}
Accept: {{json}}

{
  "nombre": "Producto y Plataforma"
}

### Actualizar departamento inexistente (error esperado 404)
PUT {{host}}/api/departamentos/999999
Content-Type: {{json}}
Accept: {{json}}

{
  "nombre": "Departamento Fantasma"
}

### Actualizar departamento inválido (400)
PUT {{host}}/api/departamentos/1
Content-Type: {{json}}
Accept: {{json}}

{
  "nombre": "   "
}

### Eliminar departamento sin usuarios asociados (204)
DELETE {{host}}/api/departamentos/2
Accept: {{json}}

### Eliminar departamento con usuarios asociados (error esperado 409)
DELETE {{host}}/api/departamentos/1
Accept: {{json}}

### Eliminar departamento inexistente (error esperado 404)
DELETE {{host}}/api/departamentos/999999
Accept: {{json}}

